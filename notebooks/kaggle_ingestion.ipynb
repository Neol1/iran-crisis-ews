    "# Load Kaggle Secrets securely (Protocol S1/S2)\n",
    "import os\n",
    "from kaggle_secrets import UserSecretsClient\n",
    "\n",
    "secrets = UserSecretsClient()\n",
    "os.environ['ACLED_KEY'] = secrets.get_secret('ACLED_KEY')\n",
    "os.environ['ACLED_EMAIL'] = secrets.get_secret('ACLED_EMAIL')\n",
    "os.environ['FIRMS_KEY'] = secrets.get_secret('FIRMS_KEY')\n",
    "\n",
    "print('ACLED_KEY loaded:', bool(os.environ.get('ACLED_KEY')))",
    "print('FIRMS_KEY loaded:', bool(os.environ.get('FIRMS_KEY')))")
